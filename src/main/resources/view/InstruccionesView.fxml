<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="5.0" styleClass="fondo" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="54.0" prefWidth="600.0" text="¿COMO SE JUEGA?" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font></Label>
      <Label lineSpacing="5.0" prefHeight="39.0" prefWidth="491.0" text="1. Coloca tu flota en el tablero de posición. Puedes ubicar los barcos de forma horizontal o vertical, sin que se superpongan ni salgan del tablero." textFill="WHITE" wrapText="true" />
      <Label prefHeight="17.0" prefWidth="489.0" text="2. Cuando todos los barcos estén ubicados, presiona Iniciar partida." textFill="WHITE" />
      <Label prefHeight="17.0" prefWidth="491.0" text="3. En el tablero principal, haz clic sobre una casilla para realizar un disparo al territorio enemigo." textFill="WHITE" />
      <Label prefHeight="35.0" prefWidth="491.0" text="4. El resultado de cada disparo puede ser:" textFill="WHITE" wrapText="true" />
      <Label text="► Agua: no impactaste ningún barco y el turno pasa a la máquina." textFill="WHITE" />
      <Label prefHeight="17.0" prefWidth="352.0" text="► Tocado: impactaste un barco; puedes volver a disparar." textFill="WHITE" />
      <Label prefHeight="42.0" prefWidth="356.0" text="► Hundido: destruiste un barco completo; puedes seguir disparando hasta fallar o ganar la partida." textFill="WHITE" wrapText="true" />
      <Label prefHeight="47.0" prefWidth="488.0" text="5. La partida termina cuando uno de los jugadores hunde los 10 barcos del oponente. El primero en lograrlo será el ganador." textFill="WHITE" wrapText="true" />
      <Button mnemonicParsing="false" text="REGRESAR" textFill="#33319e" />
   </children>
   <padding>
      <Insets right="5.0" />
   </padding>
</VBox>
